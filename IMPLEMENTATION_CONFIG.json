      16,
      48,
      48
    ],
    "batch_size": 2,
    "steps": 1200,
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "gradient_clip_norm": 3.0
  },
  "loss": {
    "smooth_l1_beta": 0.02,
    "detail_weight_eta": 2.0,
    "magnitude_scale_tau": 0.05,
    "magnitude_cap_kappa": 3.0,
    "residual_penalty_mu": 0.0001
  },
