{
  "paper": "Kronecker-Structured Video Completion with Cross-Fitted Self-Supervised Residual Learning",
  "development": {
    "videos": [
      "Akiyo",
      "Foreman",
      "Mobile"
    ],
    "sampling_rate": 0.2,
    "train_fraction": 0.8
